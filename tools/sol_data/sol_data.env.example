# sol_data.py provider file. Copy to sol_data.env, chmod 600, and NEVER commit it (it is in .gitignore).
# Free keyed endpoints are optional; without any, sol_data uses the public Solana RPCs only.
# Alchemy Solana free tier (no card needed): create an app at alchemy.com and paste its URL here.
SOL_RPC_ALCHEMY=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Budget Alchemy's compute units box-wide (free tier measured ~300 CU/s account-wide; keep headroom):
SOL_CUPS_ALCHEMY=200
# Optional: Helius (used only while under its monthly cap; auto-disabled 6 h on "max usage reached").
# HELIUS_API_KEY=YOUR_HELIUS_KEY
# Optional: any other free endpoint. SOL_FULL_<NAME>=0 marks a pruned (recent-only) node.
# SOL_RPC_MYNODE=https://YOUR_FREE_RPC_URL
# SOL_RATE_MYNODE=5
# SOL_FULL_MYNODE=1
